<Window x:Class="PaymentWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaymentWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid>
        <Border Width="260" Height="400" Padding="10" Background="Gray"></Border>
        
        <StackPanel>
            <TextBlock Text="Покупка вечной подписки"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Background="Transparent"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       />
                <StackPanel>
                    <TextBlock Text="Товар:"
                               FontSize="14"
                               FontWeight="Normal"
                               Foreground="White"
                               Background="Transparent"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               />
                    <TextBlock Text="Вечная подписка"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Background="Transparent"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               />
                    <TextBlock Text="Цена: 1000 руб."
                               FontSize="14"
                               FontWeight="Normal"
                               Foreground="Black"
                               Background="Transparent"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               />
            </StackPanel>

            <Button Content="Оплатить"
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Click="PayButton_Click"
                    />

        </StackPanel>
    </Grid>

        <Grid x:Name="SuccessfulPanel" Background="Black" Visibility="Hidden">

            <Image x:Name="Paid_True_Image"
                    Source="/images/paid_true.png"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
