<Window x:Class="WPF.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Width="450"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101114">

    <Grid>

        <Border Width="360"
                Padding="30"
                Background="#181A20"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Логотип -->

                <Border Width="60"
                        Height="60"
                        Background="#6C5CE7"
                        CornerRadius="15"
                        HorizontalAlignment="Center">

                    <TextBlock Text="N"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>


                <!-- Заголовок -->

                <TextBlock Text="Создание аккаунта"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,5"/>

                <TextBlock Text="Заполните данные для регистрации"
                           Foreground="#888B96"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>


                <!-- Email -->

                <TextBlock Text="Email"
                           Foreground="#C8CAD2"
                           FontSize="13"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="EmailTextBox"
                         Height="40"
                         Background="#22242B"
                         Foreground="White"
                         BorderBrush="#30323B"
                         Padding="10"
                         FontSize="14"/>


                <!-- Логин -->

                <TextBlock Text="Логин"
                           Foreground="#C8CAD2"
                           FontSize="13"
                           Margin="0,15,0,5"/>

                <TextBox x:Name="LoginTextBox"
                         Height="40"
                         Background="#22242B"
                         Foreground="White"
                         BorderBrush="#30323B"
                         Padding="10"
                         FontSize="14"/>


                <!-- Пароль -->

                <TextBlock Text="Пароль"
                           Foreground="#C8CAD2"
                           FontSize="13"
                           Margin="0,15,0,5"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Background="#22242B"
                             Foreground="White"
                             BorderBrush="#30323B"
                             Padding="10"
                             FontSize="14"/>


                <!-- Повтор пароля -->

                <TextBlock Text="Повторите пароль"
                           Foreground="#C8CAD2"
                           FontSize="13"
                           Margin="0,15,0,5"/>

                <PasswordBox x:Name="RepeatPasswordBox"
                             Height="40"
                             Background="#22242B"
                             Foreground="White"
                             BorderBrush="#30323B"
                             Padding="10"
                             FontSize="14"/>


                <!-- Ошибка -->

                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="#FF6B6B"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>


                <!-- Регистрация -->

                <Button Content="Создать аккаунт"
                        Height="42"
                        Margin="0,18,0,0"
                        Background="#6C5CE7"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="RegisterButton_Click"/>


                <!-- Назад -->

                <Button Content="Вернуться ко входу"
                        Height="35"
                        Margin="0,10,0,0"
                        Background="Transparent"
                        Foreground="#8B7CF6"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>