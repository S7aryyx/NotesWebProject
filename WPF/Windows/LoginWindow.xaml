<Window x:Class="WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Notes_Project" Width="75" />
            <TextBlock Text="==--Авторизация--==" Width="124" />
            <TextBlock Text="Логин:" Width="40"/>
            <TextBox x:Name="loginTextBox" Width="200"/>
            <TextBlock Text="Пароль:" Width="45"/> <!--sdsldksl-->
            <TextBox x:Name="passwordTextBox" Width="200" Margin="0,5,0,20"/>
            <Button Content="Войти" Width="76" Margin="0,5,0,0"/>
            <Button Content="Регистрация" Width="100" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
    