<Window x:Class="WPF.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход"
        Width="450"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101114">

    <Grid>

        <Border Width="360"
                Padding="30"
                Background="#181A20"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Логотип -->

                <Border Width="60"
                        Height="60"
                        Background="#6C5CE7"
                        CornerRadius="15"
                        HorizontalAlignment="Center">

                    <TextBlock Text="N"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>


                <!-- Заголовок -->

                <TextBlock Text="Добро пожаловать"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,5"/>

                <TextBlock Text="Войдите в свой аккаунт"
                           Foreground="#888B96"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>


                <!-- Логин -->

                <TextBlock Text="Логин"
                           Foreground="#C8CAD2"
                           FontSize="13"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="LoginTextBox"
                         Height="40"
                         Background="#22242B"
                         Foreground="White"
                         BorderBrush="#30323B"
                         Padding="10"
                         FontSize="14"/>


                <!-- Пароль -->

                <TextBlock Text="Пароль"
                           Foreground="#C8CAD2"
                           FontSize="13"
                           Margin="0,15,0,5"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Background="#22242B"
                             Foreground="White"
                             BorderBrush="#30323B"
                             Padding="10"
                             FontSize="14"/>


                <!-- Сообщение -->

                <TextBlock x:Name="ErrorTextBlock"
                           Foreground="#FF6B6B"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>


                <!-- Кнопка входа -->

                <Button Content="Войти"
                        Height="42"
                        Margin="0,20,0,0"
                        Background="#6C5CE7"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>


                <!-- Регистрация -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                    <TextBlock Text="Нет аккаунта?"
                               Foreground="#888B96"
                               VerticalAlignment="Center"/>

                    <Button Content="Регистрация"
                            Background="Transparent"
                            Foreground="#8B7CF6"
                            BorderThickness="0"
                            Margin="5,0,0,0"
                            Cursor="Hand"
                            Click="RegisterButton_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Window>